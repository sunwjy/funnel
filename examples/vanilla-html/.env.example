# Funnel vanilla-html example — environment variables
#
# Copy this file to .env and fill in real IDs to enable actual platform dispatch.
# When left empty (or file absent), the example runs in demo mode:
#   - Debug plugin logs all events to the on-screen log panel and console.
#   - Platform plugins (GA4, Meta Pixel) are loaded with placeholder IDs
#     and will no-op because gtag/fbq are not injected without real IDs.

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Meta Pixel ID (numeric, e.g. 1234567890)
VITE_META_PIXEL_ID=
